{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://variorum.spec/schema/0.1/variorum.schema.json",
  "title": "Variorum Record",
  "description": "A sidecar record identifying, tracing and attesting one immutable artifact. Specification version 0.1.0-draft.",
  "type": "object",
  "required": ["variorum", "id", "artifact", "scheme", "created"],
  "unevaluatedProperties": true,
  "properties": {
    "variorum": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Record format version, <major>.<minor>."
    },
    "id": {
      "type": "string",
      "pattern": "^urn:variorum:sha256:[0-9a-f]{64}$",
      "description": "Derived identifier; must equal artifact.digest."
    },
    "artifact": {
      "type": "object",
      "required": ["digest"],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "size": { "type": "integer", "minimum": 0 },
        "mediaType": { "type": "string", "pattern": "^[A-Za-z0-9!#$&\\-^_.+]+/[A-Za-z0-9!#$&\\-^_.+]+$" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "scheme": {
      "oneOf": [
        {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "const": "none" }
          },
          "not": { "required": ["version"] }
        },
        {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "description": "SCH-2: a lowercase name. The reserved table in spec/02-scheme.md is informative; any other name is opaque to consumers."
            },
            "version": { "type": "string", "minLength": 1 },
            "authority": { "type": "string", "format": "uri", "pattern": "^[a-z][a-z0-9+.-]*://" },
            "sequence": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "created": { "type": "string", "format": "date-time" },
    "producer": { "$ref": "#/$defs/actor" },
    "lineage": {
      "type": "object",
      "required": ["parents"],
      "properties": {
        "parents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "relation"],
            "properties": {
              "id": { "type": "string", "pattern": "^urn:variorum:sha256:[0-9a-f]{64}$" },
              "relation": {
                "enum": ["generation", "revision", "edit", "render", "transcode", "fork", "restore", "derivation"]
              },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "recipe": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["manual", "build", "generative", "hybrid"] },
        "tool": {
          "oneOf": [
            { "$ref": "#/$defs/tool" },
            { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tool" } }
          ]
        },
        "source": {
          "type": "object",
          "properties": {
            "ref": { "type": "string" },
            "commit": { "type": "string" },
            "digest": { "type": "string" }
          },
          "anyOf": [{ "required": ["ref"] }, { "required": ["digest"] }]
        },
        "prompt": { "type": "string" },
        "seed": { "type": ["integer", "string"] },
        "parameters": { "type": "object" },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ref", "role"],
            "properties": {
              "ref": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 }
            }
          }
        },
        "determinism": { "enum": ["none", "seeded", "full"] },
        "environment": { "type": "object" },
        "steps": { "type": "array", "items": { "type": "string" } },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["build", "generative"] }
            }
          }
        },
        "generatedAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "build" } }, "required": ["kind"] },
          "then": { "required": ["source"] }
        },
        {
          "if": { "properties": { "kind": { "const": "generative" } }, "required": ["kind"] },
          "then": { "required": ["tool", "prompt"] }
        },
        {
          "if": { "properties": { "kind": { "const": "hybrid" } }, "required": ["kind"] },
          "then": { "required": ["stages"] }
        }
      ]
    },
    "state": {
      "type": "object",
      "required": ["current", "transitions"],
      "properties": {
        "current": {
          "enum": ["draft", "candidate", "approved", "published", "superseded", "rejected", "archived"]
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "actor", "at"],
            "properties": {
              "from": {
                "enum": ["draft", "candidate", "approved", "published", "superseded", "rejected", "archived"]
              },
              "to": {
                "enum": ["draft", "candidate", "approved", "published", "superseded", "rejected", "archived"]
              },
              "actor": { "$ref": "#/$defs/actor" },
              "at": { "type": "string", "format": "date-time" },
              "reason": { "type": "string" }
            }
          }
        },
        "supersededBy": { "type": "string", "pattern": "^urn:variorum:sha256:[0-9a-f]{64}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "current": { "const": "superseded" } }, "required": ["current"] },
          "then": { "required": ["supersededBy"] }
        }
      ]
    },
    "attestation": {
      "oneOf": [
        { "$ref": "#/$defs/attestation" },
        { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/attestation" } }
      ]
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^([A-Za-z0-9.-]+:)?[A-Za-z0-9._-]+$",
        "description": "CORE-10 recommends a '<prefix>:<name>' form but does not require it; the prefix is optional in this pattern so that a warning is not turned into a schema rejection."
      },
      "properties": {
        "variorum:conformance": {
          "type": "array",
          "items": { "enum": ["core", "lineage", "recipe", "attestation"] },
          "description": "CON-5: the classes the record claims. CON-6 requires each declared class other than core to be backed by its member."
        }
      }
    }
  },
  "allOf": [
    {
      "description": "ID-8: the id must be derived from the digest.",
      "if": {
        "properties": {
          "id": { "type": "string" },
          "artifact": { "type": "object", "required": ["digest"] }
        },
        "required": ["id", "artifact"]
      },
      "then": { "$comment": "Equality of the hex components is enforced by tools/variorum.py (ID-8); JSON Schema cannot express cross-field substring equality." }
    }
  ],
  "$defs": {
    "actor": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["human", "organization", "software"] },
        "software": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" }
          }
        }
      }
    },
    "tool": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "model": { "type": "string" },
        "snapshot": { "type": "string" }
      }
    },
    "attestation": {
      "type": "object",
      "required": ["algorithm", "signature"],
      "properties": {
        "algorithm": { "enum": ["ed25519", "ecdsa-p256-sha256", "rsa-pss-sha256"] },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "keyid": { "type": "string" }
      }
    }
  }
}
